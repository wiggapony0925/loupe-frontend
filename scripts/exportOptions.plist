<?xml version="1.0" encoding="UTF-8"?>
<!--
  App Store export options for scripts/build-ios-local.sh.

  This lives in scripts/ and NOT in ios/ on purpose: ios/ is generated by
  `expo prebuild` and gitignored, so a copy kept there was deleted by the
  build's own prebuild step — every local build archived successfully and
  then died at the export with "Couldn't load -exportOptionsPlist".

  signingStyle is automatic to match withIphoneDistributionSigning.js, which
  hands local signing to Xcode; xcodebuild runs with -allowProvisioningUpdates
  so it can mint or refresh the App Store profile during export.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>DCU7GHRVUQ</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
